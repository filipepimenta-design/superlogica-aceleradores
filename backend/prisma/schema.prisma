// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  qualifications Qualification[]
}

model Qualification {
  id                             String   @id @default(uuid())
  userId                         String
  user                           User     @relation(fields: [userId], references: [id])
  companyName                    String
  maturidadeScore                Int
  riscoTecnologiaScore           Int
  posicionamentoComercialScore   Int
  escalabilidadeOperacionalScore Int
  perfilDonoScore                Int
  estrategiacrescimentoScore     Int
  totalGreenSignals              Int
  totalRedSignals                Int
  profile                        String   // "acelerado" | "nao_aderente"
  notes                          String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}
